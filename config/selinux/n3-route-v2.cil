; Permanent ROM local draft; merge into consumed platform CIL, not a policy proof.
; No ksu, shell-data launcher lock, app_process or servicemanager dependency.
(type n3_route)
(roletype object_r n3_route)
(typeattributeset domain (n3_route))
(typeattributeset coredomain (n3_route))
; Fixed mtb transition crosses system/vendor boundary; existing explicit attribute.
(typeattributeset system_executes_vendor_violators (n3_route))
(type n3_route_exec)
(roletype object_r n3_route_exec)
(typeattributeset file_type (n3_route_exec))
(typeattributeset exec_type (n3_route_exec))
(typeattributeset system_file_type (n3_route_exec))
(type n3_route_socket)
(roletype object_r n3_route_socket)
(typeattributeset file_type (n3_route_socket))
(typeattributeset coredomain_socket (n3_route_socket))
(type n3_route_boot_prop)
(roletype object_r n3_route_boot_prop)
(typeattributeset property_type (n3_route_boot_prop))
(typeattributeset system_property_type (n3_route_boot_prop))
(typeattributeset system_internal_property_type (n3_route_boot_prop))
(allow init n3_route_boot_prop (property_service (set)))
(allow init n3_route_exec (file (read open getattr map execute)))
(allow init n3_route (process (transition noatsecure siginh rlimitinh)))
(allow n3_route init (process (sigchld)))
(typetransition init n3_route_exec process n3_route)
(allow n3_route n3_route_exec (file (read open getattr map execute entrypoint)))
(allow n3_route init (fd (use)))
(allow init n3_route (unix_stream_socket (create bind getattr setattr)))
(allow init n3_route_socket (sock_file (create getattr setattr relabelto)))
(allow system_server n3_route_socket (sock_file (write getattr)))
(allow system_server n3_route (unix_stream_socket (connectto)))
(allow n3_route n3_route (unix_stream_socket (create bind listen accept read write getattr getopt setopt shutdown)))
(allow n3_route n3_route (process (fork getsched)))
(allow n3_route n3_route (dir (search)))
(allow n3_route n3_route (lnk_file (read)))
(allow n3_route system_file (file (read open getattr map execute)))
(allow n3_route system_lib_file (file (read open getattr map execute)))
(allow n3_route system_linker_exec (file (read open getattr map execute)))
(allow n3_route system_bootstrap_lib_file (file (read open getattr map execute)))
(allow n3_route socket_device (dir (search getattr)))
(allow n3_route vendor_file (dir (search)))
(allow n3_route n3_route_socket (sock_file (getattr)))
(allow n3_route null_device (chr_file (read write open getattr)))
(allow n3_route build_prop (file (read open getattr map)))
(allow n3_route fingerprint_prop (file (read open getattr map)))
(allow n3_route mtb_exec (file (read open getattr map execute)))
(allow n3_route mtb (process (transition siginh rlimitinh signal)))
(typetransition n3_route mtb_exec process mtb)
(allow mtb n3_route (fd (use)))
(allow mtb n3_route (fifo_file (write getattr)))
(allow n3_route n3_route (fifo_file (create read write getattr)))
(allow mtb mtb (qipcrtr_socket (getattr read write setopt)))
(allow system_server mtb_exec (file (read open getattr)))
