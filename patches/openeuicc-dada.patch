@@ -0,0 +1,69 @@
+package im.angry.openeuicc.core
+
+import im.angry.openeuicc.di.PrivilegedAppContainer
+import kotlinx.coroutines.runBlocking
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertSame
+import org.junit.Assert.assertThrows
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.RuntimeEnvironment
+
+@RunWith(RobolectricTestRunner::class)
+class Logical1SelectionOwnerTest {
+    private val logical0 = Logical1MapEntry(0, 0, 0)
+
+    @Test
+    fun `only both complete logical0-preserving destination maps are admitted`() = runBlocking {
+        for (destination in Logical1Destination.entries) {
+            val port = if (destination == Logical1Destination.Euicc) 1 else 0
+            val request = Logical1SelectionRequest("test-operation", destination,
+                listOf(logical0, Logical1MapEntry(port, 1, 1)))
+            request.validate()
+            assertEquals(Logical1SelectionOutcome.Unavailable, UnavailableLogical1SelectionOwner.select(request))
+        }
+    }
+
+    @Test
+    fun `partial duplicate foreign and logical0-changing maps are rejected`() {
+        val invalid = listOf(
+            emptyList(), listOf(logical0), listOf(logical0, logical0),
+            listOf(Logical1MapEntry(1, 0, 0), Logical1MapEntry(1, 1, 1)),
+            listOf(logical0, Logical1MapEntry(0, 1, 1)),
+            listOf(logical0, Logical1MapEntry(1, 0, 1)),
+            listOf(logical0, Logical1MapEntry(1, 1, 0)),
+            listOf(logical0, Logical1MapEntry(1, 1, 1), Logical1MapEntry(0, 2, 2)),
+        )
+        invalid.forEach { map ->
+            assertThrows(IllegalArgumentException::class.java) {
+                Logical1SelectionRequest("test-operation", Logical1Destination.Euicc, map).validate()
+            }
+        }
+        assertThrows(IllegalArgumentException::class.java) {
+            Logical1SelectionRequest("", Logical1Destination.Euicc,
+                listOf(logical0, Logical1MapEntry(1, 1, 1))).validate()
+        }
+    }
+
+    @Test
+    fun `all profile operations fail closed without running their mutation closure`() = runBlocking {
+        val context = EuiccOperationContext("test-operation", null, 7, 1, 1, 1, 0, "ab".repeat(32))
+        for (operation in ProfileOperation.entries) {
+            var called = false
+            try {
+                UnavailableLogical1SelectionOwner.withProfileOperation(context, operation) { called = true }
+                throw AssertionError("Unavailable owner admitted $operation")
+            } catch (_: Logical1OwnerUnavailableException) {
+                assertFalse(called)
+            }
+        }
+    }
+
+    @Test
+    fun `privileged application container retains the unavailable owner`() {
+        assertSame(UnavailableLogical1SelectionOwner,
+            PrivilegedAppContainer(RuntimeEnvironment.getApplication()).profileOperationCoordinator)
+    }
+}
