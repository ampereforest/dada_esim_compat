+static int transaction_matches(const struct euicc_ctx *ctx, const struct euicc_derutil_node *node) {
+    if (node->length == 0 || node->length > 16) return 0;
+    // Stored notifications need structural validation, not association with a new download.
+    if (ctx == NULL) return 1;
+    if (ctx->http._internal.transaction_id_bin != NULL &&
+        (node->length != ctx->http._internal.transaction_id_bin_len ||
+         memcmp(node->value, ctx->http._internal.transaction_id_bin, node->length))) return 0;
+    if (ctx->http._internal.transaction_id_http != NULL) {
+        uint8_t transaction[16];
+        int length = euicc_hexutil_hex2bin(transaction, sizeof(transaction), ctx->http._internal.transaction_id_http);
+        if (length <= 0 || (uint32_t) length != node->length || memcmp(transaction, node->value, node->length)) return 0;
+    }
+    return 1;
