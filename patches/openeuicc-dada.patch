@@ -0,0 +1,15 @@
+package im.angry.openeuicc.core
+
+enum class ProfileOperation { Download, Switch, Delete, Rename, Reset, Notification }
+
+/** N3 implementations must authenticate and serialize this lease with native route work. */
+interface ProfileOperationCoordinator {
+    suspend fun <T> withProfileOperation(context: EuiccOperationContext, operation: ProfileOperation,
+                                        block: suspend () -> T): T
+}
+
+/** Unprivileged channels do not own or change any board route. Not used by the privileged LPA. */
+object LocalProfileOperationCoordinator : ProfileOperationCoordinator {
+    override suspend fun <T> withProfileOperation(context: EuiccOperationContext, operation: ProfileOperation,
+                                                block: suspend () -> T): T = block()
+}
