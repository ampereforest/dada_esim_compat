+int euicc_base64_validate(const char *encoded, uint32_t *decoded_length) {
+    if (decoded_length == NULL) return -1;
+    *decoded_length = 0;
+    if (encoded == NULL) return -1;
+    // Protocol inputs/outputs share the bounded native response limit; never allocate a
+    // huge decoded prefix from an unbounded JSON/activation payload.
+    const size_t max_encoded = ((32U * 1024 * 1024 + 2) / 3) * 4;
+    size_t count = strnlen(encoded, max_encoded + 1);
+    if (count > max_encoded || count % 4 != 0) return -1;
+    size_t padding = 0;
+    if (count != 0 && encoded[count - 1] == '=') padding++;
+    if (count > 1 && encoded[count - 2] == '=') padding++;
+    if (count / 4 * 3 - padding > 32U * 1024 * 1024) return -1;
+    for (size_t i = 0; i < count - padding; i++) {
+        if (pr2six[(unsigned char) encoded[i]] > 63) return -1;
+    }
+    if ((padding == 1 && (pr2six[(unsigned char) encoded[count - 2]] & 3) != 0) ||
+        (padding == 2 && (pr2six[(unsigned char) encoded[count - 3]] & 15) != 0)) return -1;
+    *decoded_length = count / 4 * 3 - padding;
+    return 0;
+}
