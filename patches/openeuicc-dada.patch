@@ -0,0 +1,44 @@
+package im.angry.openeuicc.ui
+
+import android.os.Bundle
+import android.widget.Toast
+import im.angry.openeuicc.common.R
+import im.angry.openeuicc.core.EuiccChannel
+import im.angry.openeuicc.core.EuiccOperationContext
+import im.angry.openeuicc.core.withValidatedEuiccChannel
+
+/** Private secondary screens require the exact destination shown by their parent. */
+abstract class BoundEuiccAccessActivity : BaseEuiccAccessActivity() {
+    protected lateinit var operationContext: EuiccOperationContext
+        private set
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        try {
+            val incoming = EuiccOperationContext.fromBundle(
+                checkNotNull(intent.getBundleExtra(EuiccOperationContext.EXTRA)))
+            operationContext = savedInstanceState?.getBundle(EuiccOperationContext.EXTRA)
+                ?.let(EuiccOperationContext::fromBundle) ?: incoming
+            check(operationContext == incoming)
+        } catch (_: Exception) {
+            Toast.makeText(this, R.string.euicc_context_unavailable, Toast.LENGTH_LONG).show()
+            setResult(RESULT_CANCELED)
+            finish()
+        }
+    }
+
+    override fun onSaveInstanceState(outState: Bundle) {
+        if (::operationContext.isInitialized) {
+            outState.putBundle(EuiccOperationContext.EXTRA, operationContext.toBundle())
+        }
+        super.onSaveInstanceState(outState)
+    }
+
+    protected suspend fun <T> readBoundChannel(block: suspend (EuiccChannel) -> T): T {
+        awaitEuiccChannelManager()
+        euiccChannelManagerService.waitForForegroundTask()
+        return euiccChannelManager.withValidatedEuiccChannel(operationContext) { channel ->
+            block(channel).also { operationContext.requireMatches(channel) }
+        }
+    }
+}
