+import org.robolectric.shadows.UiccCardInfoBuilder
+import org.robolectric.shadows.UiccPortInfoBuilder
+import org.robolectric.util.ReflectionHelpers
+
+@RunWith(RobolectricTestRunner::class)
+@Config(application = TestOpenEuiccApplication::class, sdk = [35])
+class LpaDiagnosticsDraftTest {
+    private val app = RuntimeEnvironment.getApplication()
+    private lateinit var lpa: MockLpa
+    private lateinit var manager: MockEuiccChannelManager
+    private lateinit var service: EuiccChannelManagerService
+
+    @Before fun setup() {
+        TestOpenEuiccApplication.operationCoordinator = UnavailableLogical1SelectionOwner
+        lpa = MockLpa()
+        manager = MockEuiccChannelManager(MockEuiccChannel(1, 1, lpa, 1, 7))
+        TestOpenEuiccApplication.mockEuiccChannelManager = manager
+        service = Robolectric.buildService(EuiccChannelManagerService::class.java).create().get()
+        shadowOf(app).setComponentNameAndServiceForBindService(
+            ComponentName(app, EuiccChannelManagerService::class.java), service.onBind(Intent()))
+        cards(listOf(1))
+    }
+
+    private fun cards(ports: List<Int>, cardId: Int = 7) {
+        shadowOf(app.getSystemService(TelephonyManager::class.java)).setUiccCardsInfo(listOf(
+            UiccCardInfoBuilder.newBuilder().setIsEuicc(true).setIsRemovable(false)
+                .setCardId(cardId).setEid(lpa.eID).setPhysicalSlotIndex(1)
+                .setPorts(ports.map { UiccPortInfoBuilder.newBuilder().setPortIndex(it)
+                    .setLogicalSlotIndex(it).setIsActive(true).build() }).build()))
+    }
+
+    @After fun cleanup() {
+        service.onDestroy()
+        shadowOf(Looper.getMainLooper()).idle()
+    }
+
+    private fun read(slot: Int = -1, port: Int = -1): LpaDiagnosticReport = runBlocking {
+        val deferred = CoroutineScope(Dispatchers.Default).async { LpaDiagnosticsReader(app).read(slot, port) }
+        awaitMainLooper { deferred.isCompleted }
+        deferred.await()
+    }
+
+    @Test fun countsRedactedWhileN3UnavailableAndNoMutations() {
+        lpa.addProfile(LocalProfileInfo(("89000000" + "000000000011"), LocalProfileInfo.State.Enabled,
+            "SECRET_NAME", "SECRET_NICK", "SECRET_PROVIDER", "SECRET_AID", ProfileClass.Operational))
+        val result = JSONObject(read().json())
+        assertEquals("ok", result.getString("status"))
+        assertEquals("unavailable", result.getString("n3_owner"))
+        assertEquals(1, result.getInt("profile_count"))
+        assertEquals(1, result.getInt("enabled_count"))
+        assertEquals(0, result.getInt("disabled_count"))
+        assertEquals(1, result.getInt("physical_slot"))
+        assertEquals(1, result.getInt("port"))
+        assertEquals("redacted", result.getString("card_id"))
+        assertFalse(result.toString().contains(lpa.eID))
+        assertFalse(result.toString().contains(("89000000" + "000000000011")))
+        assertFalse(result.toString().contains("SECRET"))
+        assertEquals(listOf(1 to 1), manager.physicalChannelRequests)
+        assertTrue(manager.logicalChannelRequests.isEmpty())
+        assertTrue(lpa.deleteCalls.isEmpty())
+        assertTrue(lpa.switchCalls.isEmpty())
+        assertEquals(0, lpa.downloadCalls.get())
+    }
+
+    @Test fun genuineEmptyDiffersFromFailure() {
+        assertEquals(0, read().count)
+        lpa.inventoryFailure = SecurityException("SECRET ICCID ${lpa.eID}")
+        val report = read()
+        assertEquals("profiles_get", report.phase)
+        assertEquals("SecurityException", report.errorClass)
+        assertNull(report.count)
+        assertFalse(report.json().contains("SECRET"))
+        assertFalse(report.json().contains(lpa.eID))
+    }
+
+    @Test fun ambiguousPortFailsWithoutChannelAndExplicitSelectionUsesExactPort() {
+        cards(listOf(0, 1))
+        assertEquals("card_selection", read().phase)
+        assertTrue(manager.physicalChannelRequests.isEmpty())
+        assertEquals("complete", read(1, 1).phase)
+        assertEquals(listOf(1 to 1), manager.physicalChannelRequests)
+    }
+
+    @Test fun staleIdentityCannotPublishCounts() {
+        cards(listOf(1), 8)
+        val report = read(1, 1)
+        assertEquals("identity_before_get", report.phase)
+        assertNull(report.count)
+    }
+
+    @Test fun destructiveCoordinatorRemainsFailClosedForEveryOperation() = runBlocking {
+        val identity = EuiccOperationContext.capture(manager.channel)
+        for (operation in ProfileOperation.entries) {
+            var reached = false
+            try {
+                UnavailableLogical1SelectionOwner.withProfileOperation(identity, operation) { reached = true }
+                fail("mutation admitted")
+            } catch (_: Logical1OwnerUnavailableException) { }
+            assertFalse(reached)
+        }
+    }
+
+    @Test fun unknownErrorClassAndTraceNeverExposeNamesMessagesOrStacks() {
+        class SecretNamedException : RuntimeException("SECRET ${lpa.eID}")
+        val trace = LpaDiagnosticTrace()
+        trace.failed(SecretNamedException())
+        assertEquals("OperationException", trace.initializationFailure)
+    }
+}
