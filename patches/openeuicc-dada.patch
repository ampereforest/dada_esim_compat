+import java.util.concurrent.TimeoutException
+
+@RunWith(RobolectricTestRunner::class)
+@Config(application = TestOpenEuiccApplication::class, sdk = [35])
+class N3RuntimeIntegrationDraftTest {
+    private var time = 1_000L
+    private var foreground = true
+    private class Gateway : N3Gateway {
+        var statusCalls = 0; var proposalCalls = 0; var confirmCalls = 0
+        var choice: Boolean? = null
+        var failure: Exception? = null
+        var proposalBarrier: CompletableDeferred<Unit>? = null
+        var confirmBarrier: CompletableDeferred<Unit>? = null
+        var confirmation = response("PENDING_AUTHORITATIVE_GENERATION_PROFILE_QUIESCENCE").apply { putBoolean("durable_pending", true) }
+        override suspend fun status(): Bundle { statusCalls++; failure?.let { throw it }; return response("REAL_READBACK_SUBSET") }
+        override suspend fun propose(esim: Boolean): Bundle {
+            proposalCalls++; choice = esim; proposalBarrier?.await(); failure?.let { throw it }
+            return response("CONFIRM_EXPLICIT_ROUTE_IN_FOREGROUND_UI").apply {
+                putString("consent_token", "SECRET_TOKEN"); putInt("destination", if (esim) 1 else 0)
+            }
+        }
+        override suspend fun confirm(token: String, stillForeground: () -> Boolean): Bundle {
+            confirmBarrier?.await(); check(stillForeground())
+            assertEquals("SECRET_TOKEN", token); confirmCalls++; failure?.let { throw it }
+            return confirmation
+        }
+    }
+    private val gateway = Gateway()
+    private val originalFactory = DadaRouteChoiceActivity.gatewayFactory
+    private fun session() = N3SelectionSession(gateway, { time }, { foreground })
+    companion object {
+        fun response(status: String) = Bundle().apply {
+            putInt("protocol", 2); putBoolean("lpa_leases_supported", false); putString("status", status)
+        }
+    }
+    @After fun reset() {
+        DadaRouteChoiceActivity.gatewayFactory = originalFactory
+        ShadowBinder.setCallingUid(android.os.Process.myUid())
+    }
+    @Test fun statusAndProposalNeverAutoConfirmAndTokenNeverRendered() = runBlocking {
+        val session = session()
+        session.readStatus(); session.propose(true)
+        assertEquals(1, gateway.statusCalls); assertEquals(1, gateway.proposalCalls); assertEquals(0, gateway.confirmCalls)
+        assertEquals(true, gateway.choice); assertEquals(N3SelectionSession.Phase.PROPOSAL, session.phase)
+        assertTrue(session.canConfirm()); assertFalse(session.report.contains("SECRET_TOKEN"))
+    }
+    @Test fun explicitUserConfirmationIsSingleAttemptAndDurablePendingNotCommitted() = runBlocking {
+        val session = session(); session.propose(false); session.confirmFromUserButton(); session.confirmFromUserButton()
+        assertEquals(false, gateway.choice); assertEquals(1, gateway.confirmCalls)
+        assertEquals(N3SelectionSession.Phase.CONFIRMED_PENDING, session.phase)
+        assertFalse(JSONObject(session.report).getBoolean("authoritative_committed"))
+        assertFalse(session.canConfirm())
+    }
+    @Test fun sameMapAndUnknownCommittedStringNeverBecomeSuccess() = runBlocking {
+        val session = session()
+        gateway.confirmation = response("MAP_MATCH_NO_WRITES_ROUTE_TYPE_NOT_VERIFIED")
+        session.propose(true); session.confirmFromUserButton()
+        assertEquals(N3SelectionSession.Phase.CONFIRMED_NO_WRITES_UNVERIFIED, session.phase)
+        gateway.confirmation = response("COMMITTED")
+        session.propose(true); session.confirmFromUserButton()
+        assertEquals(N3SelectionSession.Phase.CONFIRMED_UNKNOWN, session.phase)
+        assertEquals("UNRECOGNIZED_NOT_COMMITTED", JSONObject(session.report).getString("status"))
+    }
+    @Test fun pauseFocusLossExpirationAndFreshRecreationCannotReuseToken() = runBlocking {
+        val session = session(); session.propose(true); session.invalidate(); session.confirmFromUserButton()
+        session.propose(true); foreground = false; session.confirmFromUserButton(); session.invalidate()
+        foreground = true; session.propose(true); time += 25_000; session.confirmFromUserButton()
+        assertFalse(session.canConfirm()); assertEquals(0, gateway.confirmCalls)
+        val recreated = session(); recreated.confirmFromUserButton(); assertEquals(0, gateway.confirmCalls)
+    }
+    @Test fun lateProposalAfterPauseIsDiscardedEvenAfterResuming() = runBlocking {
+        val session = session(); gateway.proposalBarrier = CompletableDeferred()
+        val job = launch { session.propose(true) }; yield()
+        session.invalidate(); gateway.proposalBarrier!!.complete(Unit); job.join()
+        assertFalse(session.canConfirm()); assertEquals(0, gateway.confirmCalls)
+    }
+    @Test fun slowProposalExpiresFromRequestTime() = runBlocking {
+        val session = session(); gateway.proposalBarrier = CompletableDeferred()
+        val job = launch { session.propose(true) }; yield(); time += 25_001
+        gateway.proposalBarrier!!.complete(Unit); job.join()
+        assertEquals(N3SelectionSession.Phase.IDLE, session.phase); assertFalse(session.canConfirm())
+    }
+    @Test fun queuedConfirmationChecksEpochNotOnlyCurrentForeground() = runBlocking {
+        val session = session(); session.propose(true); gateway.confirmBarrier = CompletableDeferred()
+        val job = launch { session.confirmFromUserButton() }; yield()
+        session.invalidate(); gateway.confirmBarrier!!.complete(Unit); job.join()
+        assertEquals(0, gateway.confirmCalls); assertEquals(N3SelectionSession.Phase.CONFIRMED_UNKNOWN, session.phase)
+    }
+    @Test fun timeoutOrDenialNeverRetriesAndNeverLeaksMessage() = runBlocking {
+        val session = session(); session.propose(true)
+        gateway.failure = TimeoutException("SECRET_TOKEN SECRET_EID")
+        session.confirmFromUserButton(); session.confirmFromUserButton()
+        assertEquals(1, gateway.confirmCalls); assertEquals(N3SelectionSession.Phase.CONFIRMED_UNKNOWN, session.phase)
+        assertFalse(session.report.contains("SECRET")); assertFalse(session.canConfirm())
+    }
+    @Test fun noConfirmWithoutProposalAndBadProtocolIsFailClosed() = runBlocking {
+        val bad = object : N3Gateway {
+            override suspend fun status() = Bundle()
+            override suspend fun propose(esim: Boolean) = Bundle().apply {
+                putInt("protocol", 1); putBoolean("lpa_leases_supported", false)
+                putString("status", "CONFIRM_EXPLICIT_ROUTE_IN_FOREGROUND_UI")
+                putString("consent_token", "SECRET_TOKEN"); putInt("destination", 1)
+            }
+            override suspend fun confirm(token: String, stillForeground: () -> Boolean): Bundle = error("must not confirm")
+        }
+        val session = N3SelectionSession(bad, { time }, { true })
+        session.confirmFromUserButton(); session.propose(true); session.confirmFromUserButton()
+        assertFalse(session.canConfirm()); assertEquals(N3SelectionSession.Phase.UNAVAILABLE, session.phase)
+    }
+    @Test fun readReportUsesAllowlistNotRawOwnerBundle() {
+        val bundle = response("REAL_READBACK_SUBSET").apply {
+            putString("consent_token", "SECRET_TOKEN"); putString("eid", "SECRET_EID")
+            putString("framework_complete_map", "[0:0:0, 1:1:1]")
+            putString("framework_card_status", "SECRET_EID")
+            putStringArrayList("framework_card_ports", arrayListOf("SECRET_ICCID"))
+            putBundle("oplus_route", Bundle().apply {
+                putString("status", "REPORTED_MAY_BE_CACHED"); putInt("gpio_status", 1)
+                putBoolean("fresh_type_callback", true); putString("raw", "SECRET_ICCID")
+            })
+            putBundle("phone_type", Bundle().apply { putString("status", "SECRET_CLASS"); putBoolean("fresh_type_callback", true) })
+        }
+        val json = N3Report.json(bundle); assertFalse(json.contains("SECRET")); assertFalse(json.contains("consent_token"))
+        val result = JSONObject(json)
+        assertFalse(result.getBoolean("authoritative_committed"))
+        assertEquals("[0:0:0, 1:1:1]", result.getString("framework_complete_map"))
+        assertFalse(result.getJSONObject("oplus_route").getBoolean("fresh_type_callback"))
+    }
+    @Test fun actualJavaClientTransactsOwnProtocolAndNoForwardedUid() {
+        val codes = mutableListOf<Int>()
+        val endpoint = object : Binder() {
+            override fun onTransact(code: Int, data: Parcel, reply: Parcel?, flags: Int): Boolean {
+                codes.add(code); data.enforceInterface(Protocol.DESCRIPTOR); assertEquals(2, data.readInt())
+                when (code) {
+                    Protocol.SELECT -> assertEquals(1, data.readInt())
+                    Protocol.CONFIRM_SELECTION -> assertEquals("SECRET_TOKEN", data.readString())
+                }
+                assertEquals(0, data.dataAvail()); assertEquals(0, flags)
+                reply!!.writeNoException(); reply.writeBundle(response("REAL_READBACK_SUBSET")); return true
+            }
+        }
+        val actual = RoutingOwnerClient(endpoint)
+        actual.status(); actual.select(true); actual.confirm("SECRET_TOKEN")
+        assertEquals(listOf(1, 2, 5), codes); assertFalse(codes.contains(Protocol.BEGIN_LPA))
+    }
+
+    @Test fun nativeManageKeepsSelectionEntryWithoutMappedCardAndNoAutoCalls() {
+        val lpa = MockLpa()
+        TestOpenEuiccApplication.mockEuiccChannelManager = MockEuiccChannelManager(MockEuiccChannel(1, 1, lpa, 1, 7))
+        TestOpenEuiccApplication.operationCoordinator = UnavailableLogical1SelectionOwner
+        val app = RuntimeEnvironment.getApplication()
+        shadowOf(app.getSystemService(TelephonyManager::class.java)).setUiccCardsInfo(emptyList<android.telephony.UiccCardInfo>())
+        val controller = Robolectric.buildActivity(EuiccManageActivity::class.java,
+            Intent(EuiccService.ACTION_MANAGE_EMBEDDED_SUBSCRIPTIONS)).create().start().resume()
+        try {
+            shadowOf(Looper.getMainLooper()).idle()
+            assertFalse(controller.get().isFinishing)
+            controller.get().findViewById<Button>(R.id.euicc_manage_n3).performClick()
+            assertEquals(DadaRouteChoiceActivity::class.java.name, shadowOf(controller.get()).nextStartedActivity.component!!.className)
+            assertEquals(0, gateway.confirmCalls)
+        } finally { controller.pause().stop().destroy() }
+    }
+    @Test fun actualActivityConfirmButtonOnlyAndPauseDiscardsProposal() {
+        DadaRouteChoiceActivity.gatewayFactory = { gateway }
+        val controller = Robolectric.buildActivity(DadaRouteChoiceActivity::class.java).create().start().resume().visible()
+        val activity = controller.get()
+        try {
+            activity.onWindowFocusChanged(true)
+            val confirm = activity.findViewById<Button>(R.id.n3_confirm)
+            assertFalse(confirm.isEnabled)
+            activity.findViewById<Button>(R.id.n3_esim).performClick(); shadowOf(Looper.getMainLooper()).idle()
+            assertEquals(1, gateway.proposalCalls); assertEquals(0, gateway.confirmCalls)
+            assertTrue(confirm.isEnabled); assertFalse(activity.findViewById<TextView>(R.id.n3_report).text.contains("SECRET_TOKEN"))
+            confirm.performClick(); shadowOf(Looper.getMainLooper()).idle()
+            assertEquals(1, gateway.confirmCalls)
+            assertTrue(activity.findViewById<TextView>(R.id.n3_phase).text.contains("NOT committed"))
+            activity.findViewById<Button>(R.id.n3_psim).performClick(); shadowOf(Looper.getMainLooper()).idle()
+            controller.pause().resume(); activity.onWindowFocusChanged(true)
+            assertFalse(confirm.isEnabled); assertEquals(1, gateway.confirmCalls)
+        } finally { controller.pause().stop().destroy() }
+    }
+    @Test fun profileCoordinatorStillUnavailableForEveryOperation() = runBlocking {
+        val channel = MockEuiccChannel(1, 1, MockLpa(), 1, 7)
+        for (operation in ProfileOperation.entries) {
+            var reached = false
+            try { UnavailableLogical1SelectionOwner.withProfileOperation(EuiccOperationContext.capture(channel), operation) { reached = true }; fail("lease fabricated") }
+            catch (_: Logical1OwnerUnavailableException) { }
+            assertFalse(reached)
+        }
+    }
+    @Test fun incorporatedR2SafetyVetoesEachUnsafeOrUnavailableGetWithoutFallback() {
+        for (denied in -1..4) {
+            val probe = object : RouteChoiceSafety.Probe {
+                override fun callIdle() = denied != 0
+                override fun slotSafe(slot: Int) = denied != slot + 1
+                override fun noNativeVsim() = denied != 3
+                override fun airplaneOff() = denied != 4
+            }
+            assertEquals(denied == -1, RouteChoiceSafety.allowed(probe))
+        }
+        val broken = object : RouteChoiceSafety.Probe {
+            override fun callIdle() = true
+            override fun slotSafe(slot: Int) = true
+            override fun noNativeVsim(): Boolean = throw LinkageError("SECRET_API")
+            override fun airplaneOff(): Boolean = error("must not fallback")
+        }
+        assertFalse(RouteChoiceSafety.allowed(broken)); assertFalse(RouteChoiceSafety.allowed(null))
+    }
+}
