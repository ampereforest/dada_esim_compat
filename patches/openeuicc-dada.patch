+package im.angry.openeuicc.service
+
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import android.service.euicc.EuiccService
+import im.angry.openeuicc.ui.EuiccManageActivity
+
+/** The manifest also requires MODIFY_PHONE_STATE; extras are never forwarded. */
+class EuiccSecretCodeReceiver : BroadcastReceiver() {
+    override fun onReceive(context: Context, intent: Intent) {
+        if (intent.action != "android.provider.Telephony.SECRET_CODE" ||
+            intent.data?.toString() != "android_secret_code://3418") return
+        context.startActivity(Intent(context, EuiccManageActivity::class.java).apply {
+            action = EuiccService.ACTION_MANAGE_EMBEDDED_SUBSCRIPTIONS
+            addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+        })
+    }
+}
diff --git a/app/src/main/java/im/angry/openeuicc/service/LpaDiagnostics.kt b/app/src/main/java/im/angry/openeuicc/service/LpaDiagnostics.kt
new file mode 100644
index 0000000000000000000000000000000000000000..bd5f4526686e607b79239be275ac102c43ac0e84
--- /dev/null
+++ b/app/src/main/java/im/angry/openeuicc/service/LpaDiagnostics.kt
@@ -0,0 +1,142 @@
+package im.angry.openeuicc.service
+
+import android.content.Context
+import android.content.Intent
+import android.telephony.TelephonyManager
+import im.angry.openeuicc.core.EuiccChannel
+import im.angry.openeuicc.core.EuiccChannelManager
+import im.angry.openeuicc.core.EuiccOperationContext
+import im.angry.openeuicc.util.RealUiccCardInfoCompat
+import im.angry.openeuicc.util.bindServiceSuspended
+import im.angry.openeuicc.util.uiccCardsInfoCompat
+import kotlinx.coroutines.TimeoutCancellationException
+import kotlinx.coroutines.withContext
+import kotlinx.coroutines.withTimeout
+import net.typeblog.lpac_jni.LocalProfileInfo
+import net.typeblog.lpac_jni.LocalProfileAssistant
+import org.json.JSONObject
+import kotlin.coroutines.AbstractCoroutineContextElement
+import kotlin.coroutines.CoroutineContext
+
+/** Only fixed categories cross the boundary: never throwable messages, names or stacks. */
+internal fun diagnosticErrorClass(t: Throwable): String = when (t) {
+    is TimeoutCancellationException -> "Timeout"
+    is SecurityException -> "SecurityException"
+    is EuiccChannelManager.EuiccChannelNotFoundException -> "ChannelUnavailable"
+    is LocalProfileAssistant.ProfileInventoryException -> "ProfileInventoryException"
+    is OutOfMemoryError -> "OutOfMemoryError"
+    is LinkageError -> "LinkageError"
+    is IllegalArgumentException -> "IllegalArgumentException"
+    is IllegalStateException -> "IllegalStateException"
+    else -> "OperationException"
+}
+
+/** Diagnostic-only observation of the existing factory's suppressed initialization error. */
+internal class LpaDiagnosticTrace : AbstractCoroutineContextElement(Key) {
+    companion object Key : CoroutineContext.Key<LpaDiagnosticTrace>
+    var initializationFailure: String? = null
+        private set
+    fun failed(t: Throwable) { initializationFailure = diagnosticErrorClass(t) }
+}
+
+internal data class DiagnosticSelection(val physical: Int, val port: Int, val logical: Int)
+
+internal data class LpaDiagnosticReport(
+    val phase: String,
+    val errorClass: String? = null,
+    val selection: DiagnosticSelection? = null,
+    val count: Int? = null,
+    val enabled: Int? = null,
+    val disabled: Int? = null,
+) {
+    fun json(): String = JSONObject().apply {
+        put("schema", 1)
+        put("read_only", true)
+        put("source", "maintained_channel_manager_lpac_get")
+        put("n3_owner", "unavailable")
+        put("status", if (errorClass == null) "ok" else "error")
+        put("phase", phase)
+        put("error_class", errorClass ?: JSONObject.NULL)
+        put("card_id", "redacted")
+        put("eid", "redacted")
+        put("profile_ids", "redacted")
+        put("physical_slot", selection?.physical ?: JSONObject.NULL)
+        put("port", selection?.port ?: JSONObject.NULL)
+        put("logical_slot", selection?.logical ?: JSONObject.NULL)
+        // Unknown/failure is null, not an invented empty inventory.
+        put("profile_count", count ?: JSONObject.NULL)
+        put("enabled_count", enabled ?: JSONObject.NULL)
+        put("disabled_count", disabled ?: JSONObject.NULL)
+    }.toString()
+}
+
+internal class LpaDiagnosticsReader(private val context: Context) {
+    private val tm get() = context.getSystemService(TelephonyManager::class.java)
+
+    private fun card(slot: Int): RealUiccCardInfoCompat {
+        val cards = tm.uiccCardsInfoCompat
+        val c = checkNotNull(cards.singleOrNull { it.isEuicc && it.physicalSlotIndex == slot })
+        check(c.cardId >= 0 && cards.count { it.physicalSlotIndex == slot } == 1 &&
+            cards.count { it.cardId == c.cardId } == 1)
+        return c
+    }
+
+    suspend fun read(requestedSlot: Int, requestedPort: Int): LpaDiagnosticReport {
+        var phase = "request"
+        var selection: DiagnosticSelection? = null
+        val trace = LpaDiagnosticTrace()
+        return try {
+            withContext(trace) { withTimeout(30_000L) {
+                require(requestedSlot >= -1 && requestedSlot < 99 && requestedPort >= -1 && requestedPort <= 255)
+                phase = "card_selection"
+                val slot = if (requestedSlot >= 0) requestedSlot else
+                    checkNotNull(tm.uiccCardsInfoCompat.filter { it.isEuicc }.singleOrNull()).physicalSlotIndex
+                val c = card(slot)
+                val p = checkNotNull(c.ports.filter { it.logicalSlotIndex >= 0 &&
+                    (requestedPort < 0 || it.portIndex == requestedPort) }.singleOrNull())
+                check(p.portIndex >= 0)
+                selection = DiagnosticSelection(slot, p.portIndex, p.logicalSlotIndex)
+                phase = "manager_bind"
+                val (binder, unbind) = context.bindServiceSuspended(
+                    Intent(context, EuiccChannelManagerService::class.java), Context.BIND_AUTO_CREATE)
+                try {
+                    val service = checkNotNull((binder as? EuiccChannelManagerService.LocalBinder)?.service)
+                    phase = "manager_idle"
+                    service.waitForForegroundTask()
+                    phase = "channel_acquire"
+                    service.euiccChannelManager.withEuiccChannel(slot, p.portIndex, EuiccChannel.SecureElementId.DEFAULT) { channel ->
+                        phase = "identity_before_get"
+                        val identity = EuiccOperationContext.capture(channel)
+                        fun requireCurrent() {
+                            val now = card(slot)
+                            val portNow = checkNotNull(now.ports.singleOrNull { it.portIndex == p.portIndex })
+                            check(now.cardId == c.cardId && now.eid == c.eid &&
+                                portNow.logicalSlotIndex == p.logicalSlotIndex &&
+                                identity.cardId == now.cardId && identity.physicalSlotId == slot &&
+                                identity.portId == p.portIndex && identity.logicalSlotId == p.logicalSlotIndex)
+                            now.eid?.takeIf { it.isNotBlank() }?.let {
+                                check(EuiccOperationContext.bindEid(it) == identity.eidBinding)
+                            }
+                            identity.requireMatches(channel)
+                        }
+                        requireCurrent()
+                        phase = "profiles_get"
+                        val profiles = channel.lpa.profiles
+                        check(profiles.map { it.iccid }.distinct().size == profiles.size)
+                        val count = profiles.size
+                        val enabled = profiles.count { it.state == LocalProfileInfo.State.Enabled }
+                        val disabled = profiles.count { it.state == LocalProfileInfo.State.Disabled }
+                        phase = "identity_after_get"
+                        requireCurrent()
+                        LpaDiagnosticReport("complete", selection = selection, count = count,
+                            enabled = enabled, disabled = disabled)
+                    }
+                } finally { unbind() }
+            } }
+        } catch (t: Throwable) {
+            if (phase == "channel_acquire" && trace.initializationFailure != null)
+                LpaDiagnosticReport("channel_initialize", trace.initializationFailure, selection)
+            else LpaDiagnosticReport(phase, diagnosticErrorClass(t), selection)
+        }
+    }
+}
diff --git a/app/src/main/java/im/angry/openeuicc/service/N3EndpointReceiver.kt b/app/src/main/java/im/angry/openeuicc/service/N3EndpointReceiver.kt
new file mode 100644
index 0000000000000000000000000000000000000000..ee275d75aed57fb9f3839044337c91e755e42957
--- /dev/null
+++ b/app/src/main/java/im/angry/openeuicc/service/N3EndpointReceiver.kt
@@ -0,0 +1,39 @@
+package im.angry.openeuicc.service
+
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import android.os.Binder
+import android.os.IBinder
+import android.os.Parcel
+import org.sourceowned.n3.runtime.v2.RoutingOwnerClient
+
+/** ROM-only callback: protected receiver + owner protocol + direct system UID.
+ * UID1000 is the privileged system shared UID, not unique system_server identity.
+ * No reflected SID/PID-context API is required for provider handoff.
+ */
+class N3EndpointReceiver : BroadcastReceiver() {
+    override fun onReceive(context: Context, intent: Intent) {
+        val offer = intent.extras?.getBinder("n3_offer") ?: return
+        val pending = goAsync()
+        Thread {
+            val endpoint = object : Binder() {
+                override fun onTransact(code: Int, data: Parcel, reply: Parcel?, flags: Int): Boolean {
