index 0000000000000000000000000000000000000000..c09c234d15f33f33f2877be7114b4acfae079a7c
--- /dev/null
+++ b/app-common/src/main/java/im/angry/openeuicc/core/EuiccOperationContext.kt
@@ -0,0 +1,91 @@
+package im.angry.openeuicc.core
+
+import android.os.Bundle
+import java.security.MessageDigest
+import java.util.UUID
+
+/** Private, operation-bound identity. Logical slot numbers are not card identities. */
+data class EuiccOperationContext(
+    val operationId: String,
+    val incomingAction: String?,
+    val cardId: Int?,
+    val physicalSlotId: Int,
+    val portId: Int,
+    val logicalSlotId: Int,
+    val secureElementId: Int,
+    val eidBinding: String,
+    val profileIccid: String? = null,
+) {
+    override fun toString() = "EuiccOperationContext(identity redacted)"
+
+    fun requireMatches(channel: EuiccChannel) {
+        check(channel.valid && channel.slotId == physicalSlotId && channel.portId == portId &&
+            channel.logicalSlotId == logicalSlotId && channel.seId.id == secureElementId &&
+            channel.port.card.stableCardId == cardId && bindEid(channel.lpa.eID) == eidBinding) {
+            "Stale or unavailable eUICC operation context"
+        }
+    }
+
+    fun forProfile(iccid: String) = copy(operationId = UUID.randomUUID().toString(), profileIccid = iccid)
+
+    fun forNewOperation(action: String? = incomingAction) =
+        copy(operationId = UUID.randomUUID().toString(), incomingAction = action, profileIccid = null)
+
+    fun sameDestination(other: EuiccOperationContext): Boolean =
+        cardId == other.cardId && physicalSlotId == other.physicalSlotId && portId == other.portId &&
+            logicalSlotId == other.logicalSlotId && secureElementId == other.secureElementId &&
+            eidBinding == other.eidBinding
+
+    fun toBundle() = Bundle().apply {
+        putString("operationId", operationId)
+        putString("incomingAction", incomingAction)
+        cardId?.let { putInt("cardId", it) }
+        putInt("physicalSlotId", physicalSlotId)
+        putInt("portId", portId)
+        putInt("logicalSlotId", logicalSlotId)
+        putInt("secureElementId", secureElementId)
+        putString("eidBinding", eidBinding)
+        // Profile identity stays private to this operation; it is never logged or backed up.
+        putString("profileIccid", profileIccid)
+    }
+
+    companion object {
+        const val EXTRA = "im.angry.openeuicc.extra.OPERATION_CONTEXT"
+
+        fun bindEid(eid: String): String {
+            check(eid.isNotBlank()) { "Missing eUICC identity" }
+            return MessageDigest.getInstance("SHA-256").digest(eid.toByteArray(Charsets.UTF_8))
+                .joinToString("") { "%02x".format(it.toInt() and 0xff) }
+        }
+
+        fun capture(channel: EuiccChannel, incomingAction: String? = null,
+                    operationId: String = UUID.randomUUID().toString(), profileIccid: String? = null): EuiccOperationContext {
+            check(channel.valid && channel.slotId >= 0 && channel.portId >= 0 && channel.logicalSlotId >= 0 &&
+                channel.seId.id in 0..0xffff)
+            return EuiccOperationContext(operationId, incomingAction, channel.port.card.stableCardId,
+                channel.slotId, channel.portId, channel.logicalSlotId, channel.seId.id,
+                bindEid(channel.lpa.eID), profileIccid)
+        }
+
+        fun fromBundle(bundle: Bundle): EuiccOperationContext {
+            val context = EuiccOperationContext(
+                checkNotNull(bundle.getString("operationId")), bundle.getString("incomingAction"),
+                if (bundle.containsKey("cardId")) bundle.getInt("cardId") else null,
+                bundle.getInt("physicalSlotId", -1), bundle.getInt("portId", -1),
+                bundle.getInt("logicalSlotId", -1), bundle.getInt("secureElementId", -1),
+                checkNotNull(bundle.getString("eidBinding")), bundle.getString("profileIccid"))
+            require(context.operationId.isNotBlank() && context.physicalSlotId >= 0 && context.portId >= 0 &&
+                context.logicalSlotId >= 0 && context.secureElementId in 0..0xffff &&
+                (context.cardId == null || context.cardId >= 0) && context.eidBinding.matches(Regex("[0-9a-f]{64}")))
+            return context
+        }
+    }
+}
+
+suspend fun <T> EuiccChannelManager.withValidatedEuiccChannel(
+    context: EuiccOperationContext, block: suspend (EuiccChannel) -> T
+): T = withEuiccChannel(context.physicalSlotId, context.portId,
+    EuiccChannel.SecureElementId.createFromInt(context.secureElementId)) { channel ->
+    context.requireMatches(channel)
+    block(channel)
+}
