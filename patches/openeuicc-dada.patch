@@ -0,0 +1,120 @@
+package im.angry.openeuicc.ui
+
+import android.os.Bundle
+import android.content.Intent
+import android.service.euicc.EuiccService
+import android.widget.Toast
+import android.widget.Button
+import android.view.Menu
+import android.view.MenuItem
+import androidx.activity.enableEdgeToEdge
+import androidx.activity.result.contract.ActivityResultContracts
+import androidx.lifecycle.lifecycleScope
+import androidx.core.view.ViewCompat
+import androidx.core.view.WindowInsetsCompat
+import androidx.core.view.updatePadding
+import im.angry.openeuicc.R
+import im.angry.openeuicc.core.EuiccChannel
+import im.angry.openeuicc.core.EuiccOperationContext
+import im.angry.openeuicc.util.*
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+
+/** Protected native Manage: channel-scoped profiles plus a separate foreground N3 child. */
+class EuiccManageActivity : BaseEuiccAccessActivity(), OpenEuiccContextMarker {
+    private var operation: EuiccOperationContext? = null
+    private val routeChoice = registerForActivityResult(ActivityResultContracts.StartActivityForResult()) {
+        lifecycleScope.launch {
+            try {
+            awaitEuiccChannelManager()
+            euiccChannelManagerService.waitForForegroundTask()
+            withContext(Dispatchers.IO) { euiccChannelManager.invalidate() }
+            // Routing invalidates the old operation-bound UI context, even on a round trip.
+            operation = null
+            supportFragmentManager.findFragmentById(R.id.euicc_manage_content)?.let { fragment ->
+                supportFragmentManager.beginTransaction().remove(fragment).commitNow()
+            }
+            onInit()
+            } catch (e: Exception) {
+                if (e is kotlinx.coroutines.CancellationException) throw e
+                onEuiccServiceUnavailable(e)
+            }
+        }
+    }
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        enableEdgeToEdge()
+        super.onCreate(savedInstanceState)
+        setContentView(R.layout.activity_euicc_manage)
+        if (intent.action != EuiccService.ACTION_MANAGE_EMBEDDED_SUBSCRIPTIONS) {
+            finish(); return
+        }
+        ViewCompat.setOnApplyWindowInsetsListener(findViewById(R.id.euicc_manage_root)) { v, insets ->
+            val bars = insets.getInsets(WindowInsetsCompat.Type.systemBars())
+            v.updatePadding(top = bars.top, bottom = bars.bottom)
+            insets
+        }
+        findViewById<Button>(R.id.euicc_manage_n3).apply {
+            filterTouchesWhenObscured = true
+            setOnClickListener { openRouteChoice() }
+        }
+        operation = savedInstanceState?.getBundle(EuiccOperationContext.EXTRA)?.let(EuiccOperationContext::fromBundle)
+    }
+
+    override fun onInit() {
+        lifecycleScope.launch {
+            try {
+                check(intent.action == EuiccService.ACTION_MANAGE_EMBEDDED_SUBSCRIPTIONS)
+                val context = EuiccUiContextResolver.resolve(intent, euiccChannelManager, telephonyManager, operation)
+                operation = context
+                if (supportFragmentManager.findFragmentById(R.id.euicc_manage_content) == null) {
+                    val fragment = PrivilegedEuiccManagementFragment.newInstance(context.physicalSlotId,
+                        context.portId, EuiccChannel.SecureElementId.createFromInt(context.secureElementId))
+                    fragment.requireArguments().putBundle(EuiccOperationContext.EXTRA, context.toBundle())
+                    supportFragmentManager.beginTransaction().replace(R.id.euicc_manage_content, fragment).commit()
+                }
+            } catch (_: Exception) {
+                Toast.makeText(this@EuiccManageActivity, im.angry.openeuicc.common.R.string.euicc_context_unavailable, Toast.LENGTH_LONG).show()
+                setResult(RESULT_CANCELED)
+                // N3 selection must remain reachable when eSIM is not currently mapped.
+            }
+        }
+    }
+
+    override fun onEuiccServiceUnavailable(error: Throwable) {
+        setResult(RESULT_CANCELED)
+        Toast.makeText(this, im.angry.openeuicc.common.R.string.euicc_context_unavailable, Toast.LENGTH_LONG).show()
+        // No profile operation is launched; independent N3 entry stays available.
+    }
+
+    // R2 native Manage route item; header button also keeps the entry reachable without a toolbar.
+    override fun onCreateOptionsMenu(menu: Menu): Boolean {
+        super.onCreateOptionsMenu(menu)
+        menu.add(Menu.NONE, 0x523202, Menu.NONE, R.string.n3_open)
+        return true
+    }
+    override fun onOptionsItemSelected(item: MenuItem): Boolean {
+        if (item.itemId != 0x523202) return super.onOptionsItemSelected(item)
+        openRouteChoice(); return true
+    }
+    private fun openRouteChoice() {
+        lifecycleScope.launch {
+            try {
+            awaitEuiccChannelManager()
+            euiccChannelManagerService.waitForForegroundTask()
+            withContext(Dispatchers.IO) { euiccChannelManager.invalidate() }
+            } catch (e: Exception) {
+                if (e is kotlinx.coroutines.CancellationException) throw e
+                // Owner's lease gate remains authoritative; service unavailability must
+                // not hide routing when there is no active eUICC channel.
+            }
+            routeChoice.launch(Intent(this@EuiccManageActivity, DadaRouteChoiceActivity::class.java))
+        }
+    }
+
+    override fun onSaveInstanceState(outState: Bundle) {
+        operation?.let { outState.putBundle(EuiccOperationContext.EXTRA, it.toBundle()) }
+        super.onSaveInstanceState(outState)
+    }
+}
