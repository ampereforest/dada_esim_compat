+    fun `null binding is presented only after subclass state exists and never reconnects`() {
+        val controller = Robolectric.buildActivity(BindingProbeActivity::class.java)
+        controller.get().setTheme(R.style.Theme_OpenEUICC)
+        val activity = controller.create().get()
+        try {
+            connection(activity).onNullBinding(null)
+            idle()
+            assertEquals(0, activity.failures)
+            controller.start().resume().visible()
+            idle()
+            assertEquals(1, activity.failures)
+            assertEquals(0, activity.initializations)
+            assertTrue(activity.euiccChannelManagerLoaded.isCompleted)
+            assertTrue(runBlocking { runCatching { activity.awaitEuiccChannelManager() }.isFailure })
+            connection(activity).onBindingDied(null)
+            idle()
+            assertEquals(1, activity.failures)
+        } finally {
+            controller.pause().stop().destroy()
+            idle()
+        }
+    }
+
+    @Test
+    fun `late binding and failure callbacks after destruction cannot initialize or navigate`() {
+        val app = RuntimeEnvironment.getApplication()
+        val service = Robolectric.buildService(EuiccChannelManagerService::class.java).create().get()
+        val controller = Robolectric.buildActivity(BindingProbeActivity::class.java)
+        controller.get().setTheme(R.style.Theme_OpenEUICC)
+        val activity = controller.create().start().resume().get()
+        val connection = connection(activity)
+        controller.pause().stop().destroy()
+        connection.onServiceConnected(ComponentName(app, EuiccChannelManagerService::class.java), service.onBind(Intent()))
+        connection.onServiceDisconnected(null)
+        idle()
+        assertEquals(0, activity.initializations)
+        assertEquals(0, activity.failures)
+        assertTrue(activity.euiccChannelManagerLoaded.isCancelled)
+        service.onDestroy()
+        idle()
+    }
+
+    @Test
+    fun `binding loss invalidates an already completed loaded signal without reinitializing`() {
+        val app = RuntimeEnvironment.getApplication()
+        val service = Robolectric.buildService(EuiccChannelManagerService::class.java).create().get()
+        shadowOf(app).setComponentNameAndServiceForBindService(
+            ComponentName(app, EuiccChannelManagerService::class.java), service.onBind(Intent()))
+        val controller = Robolectric.buildActivity(BindingProbeActivity::class.java)
+        controller.get().setTheme(R.style.Theme_OpenEUICC)
+        val activity = controller.setup().get()
+        try {
+            idle()
+            assertEquals(1, activity.initializations)
+            assertFalse(runBlocking { runCatching { activity.awaitEuiccChannelManager() }.isFailure })
+            connection(activity).onServiceDisconnected(null)
+            idle()
+            assertEquals(1, activity.failures)
+            assertTrue(runBlocking { runCatching { activity.awaitEuiccChannelManager() }.isFailure })
+            connection(activity).onServiceConnected(null, service.onBind(Intent()))
+            idle()
+            assertEquals(1, activity.initializations)
+        } finally {
+            controller.pause().stop().destroy()
+            service.onDestroy()
+            idle()
+        }
+    }
+}
+
+class BindingProbeActivity : BaseEuiccAccessActivity() {
+    var initializations = 0
+    var failures = 0
+    override fun onInit() { initializations++ }
+    override fun onEuiccServiceUnavailable(error: Throwable) { failures++ }
+}
