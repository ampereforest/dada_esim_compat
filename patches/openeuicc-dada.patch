@@ -0,0 +1,9 @@
+package im.angry.openeuicc.util
+
+/** ISO 7816 logical channel coding. Java/OMAPI handles are not implicitly CLA bits. */
+fun encodeApduClaChannel(cla: Byte, channel: Int): Byte {
+    require(channel in 0..19) { "Invalid physical logical channel" }
+    val value = cla.toInt() and 0xff
+    return if (channel < 4) ((value and 0xfc) or channel).toByte()
+    else ((value and 0xb0) or 0x40 or (channel - 4)).toByte()
+}
