+    for (unsigned i = 0; i < count; i++) {
+        if (euicc_derutil_unpack_first(&fields[i], parent->value + offset, parent->length - offset) ||
+            fields[i].tag != tags[i]) return -1;
+        offset += fields[i].self.length;
+    }
+    while (offset < parent->length) {
+        if (euicc_derutil_unpack_first(&field, parent->value + offset, parent->length - offset)) return -1;
+        for (unsigned i = 0; i < count; i++) if (field.tag == tags[i]) return -1;
+        offset += field.self.length;
+    }
+    return 0;
