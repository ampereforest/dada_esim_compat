+package im.angry.openeuicc.service
+
+import android.content.Intent
+import android.net.Uri
+import im.angry.openeuicc.testutil.TestOpenEuiccApplication
+import org.junit.Assert.*
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.RuntimeEnvironment
+import org.robolectric.Shadows.shadowOf
+import org.robolectric.annotation.Config
+
+@RunWith(RobolectricTestRunner::class)
+@Config(application = TestOpenEuiccApplication::class, sdk = [35])
+class EuiccSecretCodeReceiverTest {
+    @Test fun exactCodeOpensManageWithoutForwardingExtras() {
+        val app = RuntimeEnvironment.getApplication()
+        EuiccSecretCodeReceiver().onReceive(app, Intent("android.provider.Telephony.SECRET_CODE",
+            Uri.parse("android_secret_code://3418")).putExtra("untrusted", "ignored"))
+        val launch = shadowOf(app).nextStartedActivity
+        assertEquals("im.angry.openeuicc.ui.EuiccManageActivity", launch.component?.className)
+        assertEquals("android.service.euicc.action.MANAGE_EMBEDDED_SUBSCRIPTIONS", launch.action)
+        assertTrue(launch.flags and Intent.FLAG_ACTIVITY_NEW_TASK != 0)
+        assertNull(launch.extras)
+    }
+
+    @Test fun malformedOrDifferentEntrypointsAreIgnored() {
+        val app = RuntimeEnvironment.getApplication()
+        val receiver = EuiccSecretCodeReceiver()
+        for (uri in listOf("android_secret_code://3419", "https://3418",
+            "android_secret_code://3418/path", "android_secret_code://3418?extra=1")) {
+            receiver.onReceive(app, Intent("android.provider.Telephony.SECRET_CODE", Uri.parse(uri)))
+            assertNull(shadowOf(app).nextStartedActivity)
+        }
+        receiver.onReceive(app, Intent("android.telephony.action.SECRET_CODE", Uri.parse("android_secret_code://3418")))
+        receiver.onReceive(app, Intent("android.provider.Telephony.SECRET_CODE"))
+        assertNull(shadowOf(app).nextStartedActivity)
+    }
+}
