@@ -0,0 +1,47 @@
+package im.angry.openeuicc.n3
+
+import android.os.Bundle
+import im.angry.openeuicc.testutil.TestOpenEuiccApplication
+import kotlinx.coroutines.runBlocking
+import org.json.JSONObject
+import org.junit.Assert.*
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+
+@RunWith(RobolectricTestRunner::class)
+@Config(application = TestOpenEuiccApplication::class, sdk = [35])
+class N3RepeatableRouteTest {
+    private fun result(status: String) = Bundle().apply {
+        putInt("protocol", 2); putBoolean("lpa_leases_supported", true); putString("status", status)
+    }
+    @Test fun committedSwitchesCanRepeatWithoutAutomaticConfirmation() = runBlocking {
+        var confirmations = 0
+        val gateway = object : N3Gateway {
+            override suspend fun status() = result("COMMITTED")
+            override suspend fun propose(esim: Boolean) = result("CONFIRM_EXPLICIT_ROUTE_IN_FOREGROUND_UI").apply {
+                putInt("destination", if (esim) 1 else 0); putString("consent_token", "private-token")
+            }
+            override suspend fun confirm(token: String, stillForeground: () -> Boolean): Bundle {
+                assertTrue(stillForeground()); assertEquals("private-token", token)
+                confirmations++; return result("COMMITTED").apply { putBoolean("durable_pending", false) }
+            }
+        }
+        val session = N3SelectionSession(gateway, { 1000 }, { true })
+        for ((index, choice) in listOf(false, true, false, true).withIndex()) {
+            session.propose(choice)
+            assertEquals(index, confirmations)
+            session.confirmFromUserButton()
+            assertEquals(N3SelectionSession.Phase.COMMITTED, session.phase)
+            assertFalse(session.busy); assertFalse(session.canConfirm())
+            assertTrue(JSONObject(session.report).getBoolean("route_committed"))
+            assertFalse(session.report.contains("private-token"))
+        }
+        assertEquals(4, confirmations)
+    }
+    @Test fun pendingIsNeverRenderedAsCommitted() {
+        val pending = result("COMMITTED").apply { putBoolean("durable_pending", true) }
+        assertFalse(JSONObject(N3Report.json(pending)).getBoolean("route_committed"))
+    }
+}
