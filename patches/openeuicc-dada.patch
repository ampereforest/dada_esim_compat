@@ -0,0 +1,29 @@
+package im.angry.openeuicc.core
+
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class RegistrationObservationWindowTest {
+    @Test fun earlyTransientIsNotRecovery() {
+        val window = RegistrationObservationWindow()
+        for (time in 0L..4_000L step 1_000L) assertFalse(window.observe(1, time, true))
+        assertFalse(window.observe(1, 5_000, false))
+        assertFalse(window.observe(1, 6_000, true))
+        assertFalse(window.observe(1, 7_000, true))
+        assertTrue(window.observe(1, 8_000, true))
+    }
+
+    @Test fun missingTargetAndChangedSubscriptionResetStability() {
+        val window = RegistrationObservationWindow()
+        assertFalse(window.observe(1, 5_000, true))
+        assertFalse(window.observe(1, 6_000, true))
+        assertFalse(window.observe(null, 7_000, true))
+        assertFalse(window.observe(1, 8_000, true))
+        assertFalse(window.observe(1, 9_000, true))
+        assertFalse(window.observe(2, 10_000, true))
+        assertFalse(window.observe(2, 11_000, true))
+        assertTrue(window.observe(2, 12_000, true))
+        assertFalse(window.observe(2, 13_000, false))
+    }
+}
diff --git a/app/src/test/java/im/angry/openeuicc/n3/N3RepeatableRouteTest.kt b/app/src/test/java/im/angry/openeuicc/n3/N3RepeatableRouteTest.kt
